datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CompanyStatus {
  PENDING
  APPROVED
  SUSPENDED
  DELETED
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  EMPLOYEE
  FREELANCER
}

enum EmployeeType {
  PERMANENT
  FREELANCER
  PART_TIME
  VENDOR_STAFF
}

enum EventType {
  WEDDING
  ENGAGEMENT
  BIRTHDAY
  CORPORATE_EVENT
  CONFERENCE
  PRODUCT_LAUNCH
  PRIVATE_EVENT
  PHOTOSHOOT
  GRADUATION
  OTHER
}

enum BookingStatus {
  UPCOMING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum InvoiceStatus {
  PAID
  PARTIALLY_PAID
  PENDING
  OVERDUE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Plan {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique @db.VarChar(50)
  monthlyPrice Decimal   @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice  Decimal   @map("yearly_price") @db.Decimal(10, 2)
  features     Json
  companies    Company[]
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("plans")
}

model Company {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(100)
  subdomain         String             @unique @db.VarChar(100)
  logoUrl           String?            @map("logo_url")
  faviconUrl        String?            @map("favicon_url")
  address           String?
  vatNumber         String?            @map("vat_number") @db.VarChar(50)
  website           String?            @db.VarChar(255)
  socialLinks       Json?              @map("social_links")
  brandColors       Json?              @map("brand_colors")
  status            CompanyStatus      @default(PENDING)
  currency          String             @default("AED") @db.VarChar(10)
  language          String             @default("en") @db.VarChar(10)
  planId            String?            @map("plan_id") @db.Uuid
  plan              Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  users             User[]
  clients           Client[]
  events            Event[]
  quotations        Quotation[]
  invoices          Invoice[]
  payments          Payment[]
  subscription      Subscription?
  venues            Venue[]
  communicationLogs CommunicationLog[]
  availabilities    Availability[]
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@index([subdomain])
  @@map("companies")
}

model User {
  id                  String                 @id @default(uuid()) @db.Uuid
  companyId           String?                @map("company_id") @db.Uuid
  company             Company?               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName           String                 @map("first_name") @db.VarChar(50)
  lastName            String                 @map("last_name") @db.VarChar(50)
  email               String                 @unique @db.VarChar(100)
  phone               String?                @db.VarChar(20)
  passwordHash        String                 @map("password_hash") @db.VarChar(255)
  role                UserRole
  googleCalendarToken String?                @map("google_calendar_token") @db.Text
  isActive            Boolean                @default(true) @map("is_active")
  employeeProfile     EmployeeProfile?
  assignments         EventStaffAssignment[]
  availabilities      Availability[]
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId])
  @@index([email])
  @@map("users")
}

model EmployeeProfile {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @unique @map("user_id") @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId       String?      @map("employee_id") @db.VarChar(50)
  gender           String?      @db.VarChar(15)
  dob              DateTime?    @db.Date
  nationality      String?      @db.VarChar(50)
  designation      String?      @db.VarChar(100)
  employeeType     EmployeeType @default(PERMANENT) @map("employee_type")
  address          String?
  skills           String[]
  passportNumber   String?      @map("passport_number") @db.VarChar(50)
  passportExpiry   DateTime?    @map("passport_expiry") @db.Date
  visaNumber       String?      @map("visa_number") @db.VarChar(50)
  visaExpiry       DateTime?    @map("visa_expiry") @db.Date
  emiratesId       String?      @map("emirates_id") @db.VarChar(50)
  drivingLicense   String?      @map("driving_license") @db.VarChar(50)
  insuranceDetails String?      @map("insurance_details")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@map("employee_profiles")
}

model CompanyRegistration {
  id              String        @id @default(uuid()) @db.Uuid
  companyName     String        @map("company_name") @db.VarChar(100)
  ownerName       String        @map("owner_name") @db.VarChar(100)
  email           String        @db.VarChar(100)
  phone           String        @db.VarChar(20)
  country         String        @db.VarChar(100)
  city            String        @db.VarChar(100)
  tradeLicenseUrl String?       @map("trade_license_url")
  logoUrl         String?       @map("logo_url")
  employeeCount   Int           @default(1) @map("employee_count")
  status          CompanyStatus @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@map("company_registrations")
}

model Client {
  id         String      @id @default(uuid()) @db.Uuid
  companyId  String      @map("company_id") @db.Uuid
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String      @db.VarChar(150)
  phone      String?     @db.VarChar(20)
  email      String?     @db.VarChar(100)
  address    String?
  notes      String?
  events     Event[]
  quotations Quotation[]
  invoices   Invoice[]
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId])
  @@map("clients")
}

model Event {
  id                 String                 @id @default(uuid()) @db.Uuid
  companyId          String                 @map("company_id") @db.Uuid
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId           String?                @map("client_id") @db.Uuid
  client             Client?                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientName         String?                @map("client_name") @db.VarChar(150)
  clientPhone        String?                @map("client_phone") @db.VarChar(30)
  title              String                 @db.VarChar(150)
  type               EventType              @default(WEDDING)
  venue              String?                @db.VarChar(255)
  googleMapsUrl      String?                @map("google_maps_url")
  eventDate          DateTime?              @map("event_date") @db.Date
  startTime          String?                @map("start_time") @db.VarChar(10)
  endTime            String?                @map("end_time") @db.VarChar(10)
  notes              String?
  additionalNotes    String?                @map("additional_notes")
  bookingStatus      BookingStatus          @default(UPCOMING) @map("booking_status")
  quotationAmount    Decimal                @default(0.00) @map("quotation_amount") @db.Decimal(12, 2)
  advanceAmount      Decimal                @default(0.00) @map("advance_amount") @db.Decimal(12, 2)
  additionalExpenses Decimal                @default(0.00) @map("additional_expenses") @db.Decimal(12, 2)
  profit             Decimal                @default(0.00) @db.Decimal(12, 2)
  staffAssignments   EventStaffAssignment[]
  quotations         Quotation[]
  invoices           Invoice[]
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId])
  @@index([eventDate])
  @@map("events")
}

model EventStaffAssignment {
  id        String           @id @default(uuid()) @db.Uuid
  eventId   String           @map("event_id") @db.Uuid
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      String           @db.VarChar(100)
  status    AssignmentStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([eventId, userId])
  @@map("event_staff_assignments")
}

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId        String          @map("client_id") @db.Uuid
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  eventId         String?         @map("event_id") @db.Uuid
  event           Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  quotationNumber String          @map("quotation_number") @db.VarChar(50)
  services        Json
  termsConditions String?         @map("terms_conditions")
  status          QuotationStatus @default(DRAFT)
  magicLinkToken  String?         @unique @map("magic_link_token") @db.VarChar(100)
  signatureUrl    String?         @map("signature_url")
  signedAt        DateTime?       @map("signed_at") @db.Timestamptz
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([companyId, quotationNumber])
  @@map("quotations")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId      String        @map("client_id") @db.Uuid
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  eventId       String?       @map("event_id") @db.Uuid
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  invoiceNumber String        @map("invoice_number") @db.VarChar(50)
  subtotal      Decimal       @db.Decimal(12, 2)
  taxRate       Decimal       @default(5.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  discount      Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  dueDate       DateTime      @map("due_date") @db.Date
  status        InvoiceStatus @default(PENDING)
  qrCodeData    String?       @map("qr_code_data")
  payments      Payment[]
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([companyId, invoiceNumber])
  @@map("invoices")
}

model Payment {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceId       String   @map("invoice_id") @db.Uuid
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount          Decimal  @db.Decimal(12, 2)
  paymentDate     DateTime @default(now()) @map("payment_date") @db.Date
  paymentMethod   String   @map("payment_method") @db.VarChar(50)
  referenceNumber String?  @map("reference_number") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("payments")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  companyId            String             @unique @map("company_id") @db.Uuid
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId               String             @map("plan_id") @db.Uuid
  status               SubscriptionStatus @default(TRIALING)
  stripeSubscriptionId String?            @map("stripe_subscription_id") @db.VarChar(100)
  currentPeriodStart   DateTime           @map("current_period_start") @db.Timestamptz
  currentPeriodEnd     DateTime           @map("current_period_end") @db.Timestamptz
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@map("subscriptions")
}

model Venue {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String   @db.VarChar(150)
  address      String?
  capacity     Int?
  contactName  String?  @map("contact_name") @db.VarChar(100)
  contactPhone String?  @map("contact_phone") @db.VarChar(20)
  contactEmail String?  @map("contact_email") @db.VarChar(100)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId])
  @@map("venues")
}

model CommunicationLog {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId  String?  @map("client_id") @db.Uuid
  type      String   @db.VarChar(20) // EMAIL, WHATSAPP, SMS
  subject   String?  @db.VarChar(255)
  content   String   @db.Text
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz
  status    String   @default("SENT") @db.VarChar(20) // SENT, DELIVERED, FAILED
  metadata  Json?

  @@index([companyId])
  @@index([clientId])
  @@map("communication_logs")
}

model Availability {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String?  @db.VarChar(255)
  status    String   @default("APPROVED") @db.VarChar(20) // APPROVED, PENDING
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId])
  @@index([userId])
  @@map("availabilities")
}
